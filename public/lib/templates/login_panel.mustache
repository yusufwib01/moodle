{{!
    @template core/login_panel

    Default content for the left panel of the split-screen login layout.

    Displays a welcome heading, description, community tagline, and
    placeholder stats. Themes can override this partial to provide
    custom branding or dynamic content.

    Example context (json):
    {}
}}
<div class="login-layout-left-content">
    <h1 class="mb-3">{{#str}}loginwelcometitle{{/str}}</h1>
    <p class="mx-auto mb-4">{{#str}}loginwelcomedescription{{/str}}</p>
    <p class="mx-auto mb-4">{{#str}}loginpaneltagline{{/str}}</p>
    <div class="login-layout-stats" role="presentation">
        <div class="login-layout-stat">
            <strong class="login-layout-stat-value">500+</strong>
            <span>{{#str}}loginstatcourses{{/str}}</span>
        </div>
        <div class="login-layout-stat">
            <strong class="login-layout-stat-value">50k</strong>
            <span>{{#str}}loginstatstudents{{/str}}</span>
        </div>
        <div class="login-layout-stat">
            <strong class="login-layout-stat-value">100+</strong>
            <span>{{#str}}loginstatinstructors{{/str}}</span>
        </div>
    </div>
</div>
